# Anthropic API key for the LIVE "Drop a new claim" model calls.
# Get one from https://console.anthropic.com. Copy this file to ".env" and fill it in,
# OR set ANTHROPIC_API_KEY as a system environment variable.
# If unset (or a call fails), "Drop a claim" falls back to a deterministic simulated
# assessment, so the demo still works without a key.
ANTHROPIC_API_KEY=

# Optional model override; defaults to claude-sonnet-4-6.
# Set to claude-opus-4-8 to demo the more capable model.
# CLAUDE_MODEL=claude-sonnet-4-6
